{
  "name": "reassign_task",
  "title": "Reassign a task",
  "description": "Change a card's assignee (null clears it), with a reason on its timeline under your name; on a started card the old assignee hands over first. Closed cards, themes and members on leave are refused. Starts no work (start_task). Only if the project settings let the PM reassign cards.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "task_key": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$"
      },
      "assignee": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "required": [
      "task_key",
      "assignee",
      "reason"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Reassign a task",
    "readOnlyHint": false,
    "destructiveHint": false,
    "openWorldHint": false
  }
}
