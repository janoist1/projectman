          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
      },
      "required": [
        "request_key",
        "command",
      ],
      "type": "object",
    },
    "name": "execute_operation",
    "title": "Execute one command as the Operator or PM",
  },
  {
    "annotations": {
