                    },
                    "themeKey": {
                      "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
                      "type": "string",
                    },
                    "title": {
                      "minLength": 1,
                      "type": "string",
                    },
                    "visibility": {
                      "enum": [
                        "internal",
                        "shared",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "title",
                  ],
                  "type": "object",
                },
              },
              "required": [
