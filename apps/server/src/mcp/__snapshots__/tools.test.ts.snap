                              "type": "integer",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "maxFixRounds": {
                          "maximum": 10,
                          "minimum": 1,
                          "type": "integer",
                        },
                        "minFreeDiskGb": {
                          "maximum": 10000,
                          "minimum": 0,
                          "type": "integer",
                        },
                        "pauseAbovePlanUsagePercent": {
                          "maximum": 100,
                          "minimum": 10,
                          "type": "integer",
                        },
                        "seniorWaitMinutes": {
                          "maximum": 1440,
                          "minimum": 5,
                          "type": "integer",
                        },
                        "tempWorkers": {
                          "additionalProperties": false,
                          "properties": {
                            "enabled": {
                              "type": "boolean",
                            },
                            "max": {
                              "maximum": 5,
                              "minimum": 0,
                              "type": "integer",
                            },
                            "role": {
                              "pattern": "^[a-z][a-z0-9_]{1,39}$",
                              "type": "string",
                            },
                          },
                          "type": "object",
                        },
                        "warnAboveSessionTokens": {
                          "anyOf": [
                            {
                              "maximum": 1000000000,
                              "minimum": 10000,
                              "type": "integer",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                      },
                      "type": "object",
                    },
