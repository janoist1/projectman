                    "boundary": {
                      "properties": {
                        "enabled": {
                          "default": false,
                          "type": "boolean",
                        },
                        "leadTimeoutSeconds": {
                          "default": 120,
                          "maximum": 600,
                          "minimum": 1,
                          "type": "integer",
                        },
                      },
                      "type": "object",
                    },
                    "cardMover": {
                      "oneOf": [
                        {
                          "properties": {
                            "kind": {
                              "const": "worker",
                              "type": "string",
