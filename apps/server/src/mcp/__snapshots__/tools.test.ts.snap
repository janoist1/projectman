  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Screen an AI member’s question",
    },
    "description": "Only the Operator, not in a guest conversation; needs no owner request. Settle a question an AI member asked a person, which waits for you in the inbox state screening (the notice lists them). Always give note, the reason or background (the owner and the timeline see it). Outcomes: answered (a fact you found on the card, in the decision log, the roadmap, the code or an earlier owner answer; needs answer, name the source in note; the member is told the answer is yours and may ask a person again), forwarded (answering is another AI member’s part of the work; needs forward_to, an AI member other than the asker and you; that member is woken), moot (the question is obsolete; also works on a question that already went to the people), decision (a person must decide: it opens in the inbox as asked), todo (only a person can do it; needs todo with the exact step: what, where, expected; the inbox shows Done / Cannot do it). Other fields than the outcome needs are refused (invalid_outcome_fields). After the ten minutes are over the question belongs to the people: question_not_screening, except moot.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "answer": {
          "description": "The answer; only with answered.",
          "maxLength": 10000,
          "minLength": 1,
          "type": "string",
        },
        "forward_to": {
          "description": "The AI member to pass the question to; only with forwarded.",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "type": "string",
        },
        "item_id": {
          "description": "The question’s inbox item id from the notice.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "note": {
          "description": "Why, or the source of the answer. Always required.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "outcome": {
          "enum": [
            "answered",
            "forwarded",
            "moot",
            "decision",
            "todo",
          ],
          "type": "string",
        },
        "todo": {
          "additionalProperties": false,
          "description": "The exact step for a person; only with todo.",
          "properties": {
            "expected": {
              "description": "What result is expected back.",
              "maxLength": 1000,
              "minLength": 1,
              "type": "string",
            },
            "what": {
              "description": "What the person has to do.",
              "maxLength": 2000,
              "minLength": 1,
              "type": "string",
            },
            "where": {
              "description": "Where: the place, screen or system.",
              "maxLength": 500,
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "what",
            "where",
            "expected",
          ],
          "type": "object",
        },
      },
      "required": [
        "item_id",
        "outcome",
        "note",
      ],
      "type": "object",
    },
    "name": "screen_question",
    "title": "Screen an AI member’s question",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Send a team message",
    },
    "description": "Send a message to teammates (humans or AI members). AI members receive it in their session for the task: an idle session at once, one in the middle of a turn when that turn ends; the result says, per recipient, what happens to it. Humans see it in the app. Use it to hand over work, report findings or reply to a team message. The Operator starts work with start_task or start_member and uses this for information and replies. If the message would put a member to work on a card where a member of the same role already works, nothing is sent and the result names them; send again with despite_workers: true only if the parallel work is intended. Specify action for a request, review or retest request, or question to an AI member; info for status, acknowledgement or a result (review and QA results live in labels). A plain acknowledgement needs no message; an out-of-date or fulfilled request needs no reply. Before acting, compare the message time and version with the current card; do not carry out a request its sender has superseded or closed with a result label. Never reset or force-rewrite an approved branch without asking its approving reviewer first. A human's decision or action is asked with ask_human, never with send_message: a message to a human carries information only (kind info), and an action message that has a human among its recipients is refused as a whole.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "actionable_signal_ids": {
          "description": "Operator only: the subset of signal_ids whose acceptance authorizes an action.",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 20,
          "type": "array",
        },
        "attachments": {
          "description": "Files to attach: paths relative to your working directory or inside your session folder, as for attach_file. The recipients see them with the message (a human sees an image in the conversation); this is how to show a screenshot to a person. Say in text what the file is. If any file cannot be read, nothing is sent.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array",
        },
        "despite_workers": {
          "type": "boolean",
        },
        "kind": {
          "description": "action: an AI member has something to do (refused when a human is a recipient: use ask_human); info: status, acknowledgement or result; starts nothing.",
          "enum": [
            "action",
            "info",
          ],
          "type": "string",
        },
        "signal_actionable": {
          "description": "Operator only: whether accepting this signal authorizes a proposed action.",
          "type": "boolean",
        },
        "signal_id": {
          "description": "Operator only: the delivered system signal to present to owners.",
          "type": "string",
        },
        "signal_ids": {
          "description": "Operator only: delivered signals awaiting owner decisions, presented in one message.",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
        },
        "task_key": {
          "description": "Task the message is about, e.g. "AR-21". Defaults to the task of your current session. In a general (no card) session it defaults to the card of the latest card message delivered to you there (within 2 hours), so a reply stays on that card; give task_key for any other card.",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
        "text": {
          "description": "The message. Give the recipient what they need to act on it: the facts (task, links, what changed, findings) and what you expect next and from whom.",
          "maxLength": 20000,
          "minLength": 1,
          "type": "string",
        },
        "to": {
          "description": "Recipient handles, e.g. ["qa"] or ["fe-1", "owner"]. Handles only, without "@".",
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "type": "string",
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "to",
        "kind",
        "text",
      ],
      "type": "object",
    },
    "name": "send_message",
    "title": "Send a team message",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Say what you are doing",
    },
    "description": "Say, in one declarative sentence, what you are doing on your task's card now; the card shows it next to your name, e.g. "The gateway tests are being written". It always concerns your own session and card. Call it at the start of a multi-step stretch of work (implementing, testing, fixing review findings), not at every step and not for a short reply, and in the same response as your next step, never on its own. Only the latest sentence is kept, and it disappears when your round ends. Write it in the project language, without your name.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "detail": {
          "description": "More about it, at most 300 characters; only the task page shows it.",
          "maxLength": 300,
          "minLength": 1,
          "type": "string",
        },
        "summary": {
          "description": "One line, at most 80 characters, the card shows it.",
          "maxLength": 80,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "summary",
      ],
      "type": "object",
    },
    "name": "set_current_work",
    "title": "Say what you are doing",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Set personal conversation preferences",
    },
    "description": "Only the Operator, for the person currently speaking in their own conversation, including guests. Read get_operator_preference first and pass its revision as expected_revision. Changes only this person’s five style fields; grants no other write. Confirm the new style in one sentence in the project language. To reset, use brief/plain/offer/plain/minimal. On operator_knowledge_stale read again before retrying.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "preference": {
          "additionalProperties": false,
          "properties": {
            "background": {
              "enum": [
                "minimal",
                "contextual",
              ],
              "type": "string",
            },
            "clarity": {
              "enum": [
                "plain",
                "precise",
              ],
              "type": "string",
            },
            "detail": {
              "enum": [
                "offer",
                "include",
              ],
              "type": "string",
            },
            "length": {
              "enum": [
                "brief",
                "balanced",
                "detailed",
              ],
              "type": "string",
            },
            "technicalLevel": {
              "enum": [
                "plain",
                "mixed",
                "technical",
              ],
              "type": "string",
            },
          },
          "required": [
            "length",
            "technicalLevel",
            "detail",
            "clarity",
            "background",
          ],
          "type": "object",
        },
      },
      "required": [
        "expected_revision",
        "preference",
      ],
      "type": "object",
    },
    "name": "set_operator_preference",
    "title": "Set personal conversation preferences",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Start a member on work without a card",
    },
    "description": "If the message would put a member to work on a card where a member of the same role already works, nothing is sent and the result names them; send again with despite_workers: true only if the parallel work is intended. Only the Operator, during an open owner request. Starts an AI member on work that has no card: the text is their task, given to their general conversation (a running one gets it when its turn ends). It waits up to 5 seconds and says what became of the start: started, already running, starting, waiting with the reason, held, or failed. For work on a card use start_task. With task_key the text is about that card and the member needs a role on it (a card's merger or the owner of its step). With signal_id (and no owner request) and only when the project lets the Operator act on signals, it starts the member the signal names.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "despite_workers": {
          "type": "boolean",
        },
        "member": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "type": "string",
        },
        "signal_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "task_key": {
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "member",
        "text",
      ],
      "type": "object",
    },
    "name": "start_member",
    "title": "Start a member on work without a card",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Start work on a task",
    },
    "description": "Only the Operator, during an open owner request. Use the same start as the Start button, choosing an optional assignee and starting gate setters. Also starts a stalled task already in its work stage without a running session. Gates and prerequisites still apply. A refused start waits for nothing; the error names why (for example member_on_leave, member_at_capacity, team_paused). With signal_id (an idle card the system signalled) and no owner request, and only when the project lets the Operator act on signals, it starts the card's own assignee; it takes no assignee or despite_prerequisites then.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "assignee": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "type": "string",
        },
        "despite_prerequisites": {
          "type": "boolean",
        },
        "signal_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "task_key": {
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
      },
      "required": [
        "task_key",
      ],
      "type": "object",
    },
    "name": "start_task",
    "title": "Start work on a task",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Submit a boundary request",
    },
    "description": "Request one external operation registered by the protected operation adapter. Supply its opaque operation id and a stable retry key. The server derives the exact target, category, scope and expiry. This returns immediately; inspect later with get_boundary_request. Never include commands, credentials or secrets. This does not approve CLI permissions, gates or releases.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "deduplication_key": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$",
          "type": "string",
        },
        "operation_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$",
          "type": "string",
        },
      },
      "required": [
        "operation_id",
        "deduplication_key",
      ],
      "type": "object",
    },
    "name": "submit_boundary_request",
    "title": "Submit a boundary request",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Take screenshots",
    },
    "description": "Take screenshots with \`npm run shots\` (docs/SCREENSHOTS.md): the server runs the scenario of your working directory in its own sandbox, where the browser starts (it does not in yours). The images go to the 'shots' folder of your session folder; open one with your image viewing tool and attach it with attach_file. The call waits up to 40 seconds: if the run is not over then, it answers \`running\`, and you ask for its end with get_screenshot_run. One run at a time per session.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "full_page": {
          "description": "Capture the whole page by default.",
          "type": "boolean",
        },
        "scale": {
          "anyOf": [
            {
              "const": 1,
              "type": "number",
            },
            {
              "const": 2,
              "type": "number",
            },
          ],
          "description": "Device pixel ratio, 1 (default) or 2.",
        },
        "scenario": {
          "description": "The scenario module (an ES module, e.g. 'scripts/scenarios/card-with-question.mjs'): relative to your working directory, or an absolute path inside it or inside your session folder.",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "seed": {
          "description": "demo (default: the Acme webshop with four cards) or none (an empty instance).",
          "enum": [
            "demo",
            "none",
          ],
          "type": "string",
        },
        "timeout_seconds": {
          "description": "The scenario's own time limit in seconds, instance start included (default 240).",
          "maximum": 600,
          "minimum": 1,
          "type": "integer",
        },
        "widths": {
          "description": "Widths of the images in pixels (default 1512, 800, 390, 375).",
          "items": {
            "maximum": 4000,
            "minimum": 200,
            "type": "integer",
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "scenario",
      ],
      "type": "object",
    },
    "name": "take_screenshots",
    "title": "Take screenshots",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Update a task",
    },
    "description": "Record progress on a task: add or remove labels, add a note, rewrite its title or description (for example a specification with acceptance criteria, or a technical plan), set the repository it works in and/or move it to another stage. The outcome of a review, a test or a client answer is a label from the project's label list (in your instructions: meaning, who may set it). Some labels require a note, and labels only humans may set (approvals) are refused. Stage gates are enforced: a move is refused while a label its gate requires is missing or a blocking label is on the task. One call is all or nothing: labels and the note are recorded before the stage move, and if a label is refused or the gate blocks the move, nothing is recorded. A move that needs a human approval records the rest and waits for the approval. Relations between cards (part of, prerequisite, related, duplicate of) are set with add_relations and removed with remove_relations, in the same call: give the order of work as a prerequisite relation, not as a "Dependencies" text in the description. You cannot mark a card that has started as a duplicate. theme_key puts the card into a theme (an open card of kind theme in this project; null removes it); a card belongs to one theme, a subtask takes the theme of its parent and cannot be given one, and a theme cannot be given one or moved. developer_level (with developer_level_reason) sets the recommended developer of the card.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "add_labels": {
          "description": "Label ids to add (the project's labels are listed in your instructions). A label of a group replaces the other labels of that group.",
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "type": "array",
        },
        "add_relations": {
          "description": "Relations of this card to other cards to add. part_of: this card is part of the other (a one-level subtask, same project); prerequisite: this card can only be done after the other (order cards with this, not with a "Dependencies" text in the description); related: the cards belong together (follow-up work too), nothing more; duplicate_of: this card duplicates the other and is closed (cancelled) pointing at it. You can mark only a card that has not started (waiting in a queue stage, no session) as a duplicate; a card that has started can be marked only by an admin or the owner. Point at the original, never at another duplicate. A loop of prerequisites, a card to itself and a card of another project are refused with the reason; so is the whole call.",
          "items": {
            "properties": {
              "kind": {
                "description": "part_of: this card is part of the other (a one-level subtask, same project); prerequisite: this card can only be done after the other (order cards with this, not with a "Dependencies" text in the description); related: the cards belong together (follow-up work too), nothing more; duplicate_of: this card duplicates the other and is closed (cancelled) pointing at it. You can mark only a card that has not started (waiting in a queue stage, no session) as a duplicate; a card that has started can be marked only by an admin or the owner. Point at the original, never at another duplicate.",
                "enum": [
                  "part_of",
                  "prerequisite",
                  "related",
                  "duplicate_of",
                ],
                "type": "string",
              },
              "task_key": {
                "description": "The other card, in this project.",
                "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
                "type": "string",
              },
            },
            "required": [
              "kind",
              "task_key",
            ],
            "type": "object",
          },
          "maxItems": 10,
          "type": "array",
        },
        "description": {
          "description": "New description (markdown). It replaces the whole description, so include everything that should stay; read the current one with get_task first, all of it if get_task says it is cut.",
          "maxLength": 20000,
          "minLength": 1,
          "type": "string",
        },
        "developer_level": {
          "description": "The recommended developer of the card: senior (a task that suits the Senior; developer_level_reason is required) or any (any developer may take it). Only an owner, or a member who plans tasks or analyses requirements, may set it; it can be changed on a card that has started too, and it does not replace the developer who already carries the card.",
          "enum": [
            "senior",
            "any",
          ],
          "type": "string",
        },
        "developer_level_reason": {
          "description": "Why the card is recommended for that developer, at most 300 characters; required with developer_level senior, and only with developer_level.",
          "maxLength": 300,
          "minLength": 1,
          "type": "string",
        },
        "note": {
          "description": "Note for the task timeline: findings, decisions, what changed. With labels it is the comment explaining them.",
          "maxLength": 10000,
          "minLength": 1,
          "type": "string",
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "urgent",
                "high",
                "normal",
                "low",
              ],
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "The card priority: urgent, high, normal or low; null clears it. Only people and the project manager may set it; others are refused. Urgent cards start first and are pulled into development by the system; the other levels only inform.",
        },
        "remove_labels": {
          "description": "Label ids to remove.",
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "type": "array",
        },
        "remove_relations": {
          "description": "Relations of this card to other cards to remove; removals apply before additions.",
          "items": {
            "properties": {
              "kind": {
                "description": "The relation as this card sees it: part_of, has_part, prerequisite, prerequisite_of, related, duplicate_of or duplicated_by (the reverse of a relation another card set is removable too). Removing a duplicate relation does not reopen the card.",
                "enum": [
                  "part_of",
                  "has_part",
                  "prerequisite",
                  "prerequisite_of",
                  "related",
                  "duplicate_of",
                  "duplicated_by",
                ],
                "type": "string",
              },
              "task_key": {
                "description": "The other card.",
                "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
                "type": "string",
              },
            },
            "required": [
              "kind",
              "task_key",
            ],
            "type": "object",
          },
          "maxItems": 10,
          "type": "array",
        },
        "repo": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Name of the repository the task works in, one of the project repositories (an unknown name is refused, and the refusal lists them); null clears it. Refused while a session of the task is running, yours included.",
        },
        "stage_id": {
          "description": "Id of the stage to move the task to (the pipeline is in your instructions).",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string",
        },
        "task_key": {
          "description": "Task key, e.g. "AR-21".",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
        "theme_key": {
          "anyOf": [
            {
              "description": "Task key, e.g. "AR-21".",
              "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "The theme this card belongs to (a theme of this project that is open); null removes it.",
        },
        "title": {
          "description": "New title, short and specific.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "task_key",
      ],
      "type": "object",
    },
    "name": "update_task",
    "title": "Update a task",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Withdraw a question",
    },
    "description": "Withdraw a question you asked with ask_human when it became moot while you waited (the decision was made elsewhere, the work changed). Only your own question that is still waiting can be withdrawn. Give a short reason; it is recorded on the card.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "description": "Id of the question, as ask_human gave it.",
          "minLength": 1,
          "type": "string",
        },
        "reason": {
          "description": "Why it is moot, briefly.",
          "maxLength": 1000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "item_id",
        "reason",
      ],
      "type": "object",
    },
    "name": "withdraw_question",
    "title": "Withdraw a question",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Write the project documents",
    },
    "description": "Only the Operator, in the owner's own conversation, during an open owner request. Replace text in the decision log and the roadmap as ONE commit on the default branch, pushed to its remote. base_commit is the commit read_project_doc returned; edits are applied in order. Each edit replaces old_text, which must occur exactly once in the file, with new_text; an empty old_text appends new_text at the end of the file. The decision log is append-only: no existing line may change or go, so a decision is added, never rewritten. Show the owner the text before you write it. Refused when a file changed since base_commit (docs_stale: read it again), when an old_text is not found or is ambiguous, or when nothing changes. The write runs in the repository's merge slot: it may answer queued (it runs after the merge that holds the slot, and you are told how it ended with the owner's next message) or running (not finished within 60 seconds; the same). message is the commit subject: one line, English.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string",
        },
        "edits": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "doc": {
                "enum": [
                  "decisions",
                  "roadmap",
                ],
                "type": "string",
              },
              "new_text": {
                "maxLength": 20000,
                "minLength": 1,
                "type": "string",
              },
              "old_text": {
                "description": "The text to replace, exactly as in the file; empty appends at the end of the file.",
                "maxLength": 20000,
                "type": "string",
              },
            },
            "required": [
              "doc",
              "old_text",
              "new_text",
            ],
            "type": "object",
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
        },
        "message": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "type": "string",
        },
      },
      "required": [
        "base_commit",
        "message",
        "edits",
      ],
      "type": "object",
    },
    "name": "write_project_docs",
    "title": "Write the project documents",
  },
]
`;
