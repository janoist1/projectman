  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create a task",
    },
    "description": "Create a new task, for example a card for a reported bug, one part of a request you split, or follow-up work you found. It starts unassigned in the first stage of the pipeline, where humans prioritise it; it does not start any work. Give it a self-contained description. Set parent_key for a one-level subtask in the same project, and relations for the other relations to existing cards (a card it needs first is a prerequisite relation, not a "Dependencies" text). If it came from another task, note the new key there with update_task. kind "theme" creates a theme instead: a card that groups other cards (an epic) and is only open or closed; it is in no stage, has no assignee and no work is started on it. theme_key puts the new card into an open theme.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "Markdown: what and why, and what done means (for a bug: steps to reproduce, expected and actual behaviour, environment). Mention the task it came from, if any.",
          "maxLength": 20000,
          "type": "string",
        },
        "developer_level": {
          "description": "The recommended developer of the card: senior (a task that suits the Senior; developer_level_reason is required) or any (any developer may take it). Only an owner, or a member who plans tasks or analyses requirements, may set it; it can be changed on a card that has started too, and it does not replace the developer who already carries the card.",
          "enum": [
            "senior",
            "any",
          ],
          "type": "string",
        },
        "developer_level_reason": {
          "description": "Why the card is recommended for that developer, at most 300 characters; required with developer_level senior, and only with developer_level.",
          "maxLength": 300,
          "minLength": 1,
          "type": "string",
        },
        "kind": {
          "description": "task (default) or theme: a card that groups other cards; no stage, no work.",
          "enum": [
            "task",
            "theme",
          ],
          "type": "string",
        },
        "labels": {
          "description": "Labels, e.g. ["bug"].",
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "type": "array",
        },
        "parent_key": {
          "description": "Parent task in this project; must not itself be a subtask.",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
        "relations": {
          "description": "Relations of the new card to other cards. part_of: this card is part of the other (a one-level subtask, same project); prerequisite: this card can only be done after the other (order cards with this, not with a "Dependencies" text in the description); related: the cards belong together (follow-up work too), nothing more; duplicate_of: this card duplicates the other and is closed (cancelled) pointing at it. You can mark only a card that has not started (waiting in a queue stage, no session) as a duplicate; a card that has started can be marked only by an admin or the owner. Point at the original, never at another duplicate. One refused relation refuses the creation.",
          "items": {
            "properties": {
              "kind": {
                "description": "part_of: this card is part of the other (a one-level subtask, same project); prerequisite: this card can only be done after the other (order cards with this, not with a "Dependencies" text in the description); related: the cards belong together (follow-up work too), nothing more; duplicate_of: this card duplicates the other and is closed (cancelled) pointing at it. You can mark only a card that has not started (waiting in a queue stage, no session) as a duplicate; a card that has started can be marked only by an admin or the owner. Point at the original, never at another duplicate.",
                "enum": [
                  "part_of",
                  "prerequisite",
                  "related",
                  "duplicate_of",
                ],
                "type": "string",
              },
              "task_key": {
                "description": "The other card, in this project.",
                "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
                "type": "string",
              },
            },
            "required": [
              "kind",
              "task_key",
            ],
            "type": "object",
          },
          "maxItems": 10,
          "type": "array",
        },
        "theme_key": {
          "description": "The theme the new card belongs to: an open card of kind theme in this project.",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
        "title": {
          "description": "Short, specific title.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "visibility": {
          "description": "internal (default): only the team sees it; shared: client members see it too.",
          "enum": [
            "internal",
            "shared",
          ],
          "type": "string",
        },
      },
      "required": [
        "title",
      ],
      "type": "object",
    },
    "name": "create_task",
    "title": "Create a task",
  },
  {
