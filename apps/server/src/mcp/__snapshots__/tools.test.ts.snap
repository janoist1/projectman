  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Check a release",
    },
    "description": "Only the Operator; it only reads. The preview of propose_release: it runs the same checks (a release already in progress, the merged cards between the last release and the commit) and answers either the commit and the cards a release would have, or the refusal propose_release would give now, with the same code and message. It records nothing. The release is proposed by the member with the deployment duty, not by the Operator: the result lists who that is. \`commit\` is a merge commit of a merged card; default: the head of the default branch. Explain the result to the owner in the project language.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "description": "A merge commit of a merged card; default: the head of the default branch.",
          "pattern": "^[0-9a-f]{40}$",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "check_release",
    "title": "Check a release",
  },
  {
