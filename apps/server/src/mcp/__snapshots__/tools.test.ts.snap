          "type": "string",
        },
        "task_key": {
          "description": "Task key, e.g. "AR-21".",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
      },
      "required": [
        "task_key",
        "repo",
        "number",
