{
  "name": "set_email_contact",
  "title": "Record an e-mail contact choice",
  "description": "Record that a human asks for e-mail or asks not to receive it. Give one source message or one received e-mail as evidence.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "handle": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
      },
      "wants": {
        "type": "boolean"
      },
      "requested_by": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
      },
      "source_message_id": {
        "type": "string",
        "minLength": 1
      },
      "source_email_id": {
        "type": "string",
        "minLength": 1
      },
      "quote": {
        "type": "string",
        "maxLength": 300
      }
    },
    "required": [
      "handle",
      "wants",
      "requested_by"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Record an e-mail contact choice",
    "readOnlyHint": false,
    "destructiveHint": false,
    "openWorldHint": false
  }
}
