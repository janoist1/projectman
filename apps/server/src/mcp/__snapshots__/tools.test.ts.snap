                              "type": "string",
                            },
                          },
                          "required": [
                            "kind",
                          ],
                          "type": "object",
                        },
                        {
                          "properties": {
                            "handle": {
                              "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                              "type": "string",
                            },
                            "kind": {
                              "const": "member",
                              "type": "string",
                            },
                          },
                          "required": [
                            "kind",
                            "handle",
                          ],
                          "type": "object",
                        },
                      ],
                    },
                    "operatorWatch": {
                      "anyOf": [
                        {
                          "enum": [
                            "report",
                            "unblock",
                            "drive",
                          ],
                          "type": "string",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "pipeline": {
                      "properties": {
                        "columns": {
                          "items": {
                            "properties": {
                              "color": {
                                "enum": [
                                  "gray",
                                  "blue",
                                  "teal",
                                  "green",
                                  "yellow",
                                  "orange",
                                  "red",
                                  "pink",
                                  "purple",
                                ],
                                "type": "string",
                              },
                              "hint": {
                                "type": "string",
                              },
                              "id": {
                                "pattern": "^[a-z][a-z0-9_]{0,31}$",
                                "type": "string",
                              },
                              "name": {
                                "minLength": 1,
                                "type": "string",
                              },
                            },
                            "required": [
                              "id",
                              "name",
                            ],
                            "type": "object",
                          },
                          "minItems": 1,
                          "type": "array",
                        },
                        "labels": {
                          "default": [],
                          "items": {
                            "properties": {
                              "blocks": {
                                "type": "boolean",
                              },
                              "clearedWhen": {
                                "items": {
                                  "enum": [
                                    "moved_back",
                                    "pr_updated",
                                  ],
                                  "type": "string",
                                },
                                "type": "array",
                              },
                              "color": {
                                "enum": [
                                  "gray",
                                  "blue",
                                  "teal",
                                  "green",
                                  "yellow",
                                  "orange",
                                  "red",
                                  "pink",
                                  "purple",
                                ],
                                "type": "string",
                              },
                              "group": {
                                "pattern": "^[a-z][a-z0-9_-]{0,39}$",
                                "type": "string",
                              },
                              "id": {
                                "maxLength": 40,
                                "minLength": 1,
                                "type": "string",
                              },
                              "meaning": {
                                "maxLength": 500,
                                "type": "string",
                              },
                              "name": {
                                "maxLength": 60,
                                "minLength": 1,
                                "type": "string",
                              },
                              "notByAuthor": {
                                "type": "boolean",
