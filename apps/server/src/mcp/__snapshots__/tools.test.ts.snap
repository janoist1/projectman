exports[`team tool definitions > preserves the public tool definitions across module moves 1`] = `
[
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Ask the instance host",
    },
    "description": "Open a request to the host of this projectman instance. Use it only when the owners need a right or a feature that only the instance host can grant. Ask the owners first (ask_human) and open the request only with their agreement. The host sees only the title and the text, never a card, a message or anything else of the project, so never put secrets, passwords, keys or client data in them. The answer comes back to you as a system message and to the owners as an inbox alert. At most five requests may be open at once.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "body": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string",
        },
        "task_key": {
          "description": "The card the request is about, if any (the host does not see it).",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "title",
        "body",
      ],
      "type": "object",
    },
    "name": "ask_host",
    "title": "Ask the instance host",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Ask a human",
    },
    "description": "Ask a human for a decision or information you cannot find or decide yourself (requirements, priorities, access, trade-offs). Never ask for an approval label with it: an answer puts no label on, the app asks the label holders itself. The answer arrives later in this session as a team message. Do not wait or poll for it: continue with work that does not depend on the answer, or end your turn. Ask one clear question. The human who answers is usually not a specialist and often reads on a phone: start with one plain sentence that names the decision in everyday words, describe each option by what happens if it is picked, and always recommend one option with a one-sentence reason. Put code, file names and technical reasoning into details; the inbox shows it folded. Name a file of the card or its parent in attachments instead of describing where to find it. The Operator screens your question first (within 10 minutes) and tells you in a team message whether it answered it, passed it to a member, closed it or sent it on to the people.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "description": "Ids (att_…) of the files, on the question's card or its parent (list_attachments), the human needs to look at to answer. At most 6.",
          "items": {
            "pattern": "^att_[a-z0-9]{10,32}$",
            "type": "string",
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array",
        },
        "details": {
          "description": "Technical background as markdown, shown folded: the question must make sense without it.",
          "maxLength": 10000,
          "minLength": 1,
          "type": "string",
        },
        "options": {
          "description": "Suggested answers shown as buttons: a short label and its consequence (a plain label string is accepted too). Required for a decision, a yes/no question too; omit only with response_purpose information. The answerer can always write another answer.",
          "items": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "consequence": {
                    "description": "What happens if the human picks this option, in everyday words.",
