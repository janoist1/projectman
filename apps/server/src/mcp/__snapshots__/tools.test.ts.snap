  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Move a merge to the front of the queue",
    },
    "description": "Only the card's merger, or the Operator during an open owner request. One merge runs at a time per repository, in the order the cards were requested; use this to decide that this card's queued merge goes next, e.g. a fix that the queued cards' tests depend on. Only a merge that waits in the queue can move (not one that is not started yet or already runs). The merge that runs now is not interrupted. The reason goes on the card's timeline: say who or what it unblocks. A merge already at the front is left as it is (moved: false).",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "description": "Why this card goes first; it is shown on the timeline.",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "task_key": {
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
      },
      "required": [
        "task_key",
        "reason",
      ],
      "type": "object",
    },
    "name": "prioritize_merge",
    "title": "Move a merge to the front of the queue",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Propose shared Operator knowledge",
    },
    "description": "Only the Operator during an open owner message or answer. Propose an agreement replacement, principle put or removal with the current expected_revision. A null principle id gets a server id. Writes nothing until an owner approves in the inbox. Only agreement_replace accepts recommended operations (at most ten); even immediate operations must wait for this approval and protected configuration operations still require a separate approval. Never import principles automatically from memory or documents.",
