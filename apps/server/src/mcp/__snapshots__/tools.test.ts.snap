      ],
      "type": "object",
    },
    "name": "create_task_from_feedback",
    "title": "Open a card from a feedback mark",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Decide a delegated boundary request",
    },
    "description": "Independent live holders of boundary_authorization may allow or deny a delegable request before its lead deadline. Inspect its exact target first. Cost, production/release/main publication, accounts/secrets and host expansion always require the owner. Late or self decisions are refused. Use a structured reason; never include credentials.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "deny",
          ],
          "type": "string",
        },
        "reason": {
          "enum": [
            "scope_verified",
            "unsafe_target",
            "insufficient_context",
            "not_needed",
          ],
          "type": "string",
        },
        "request_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$",
          "type": "string",
        },
      },
      "required": [
        "request_id",
        "decision",
        "reason",
      ],
      "type": "object",
    },
    "name": "decide_boundary_request",
    "title": "Decide a delegated boundary request",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Decide how a card at its fix round limit goes on",
    },
    "description": "A system message told you that a card reached the limit of fix rounds and its implementer is held back: read the card and its timeline first, then decide. "continue" lets it have one more round (when you were asked for a more exact plan: the card starts a new count with your plan); "replan" (the lead only) asks another technical direction holder for a more exact plan first; "to_owner" gives the decision to the people (the integrator first, when one is available) and REQUIRES an assessment: recurrence (one sentence: does the same fault come back), current_state (where the work stands now) and recommendation (option_id replan, reassign or another_round, an outcome that can be carried out, and its reason). Without it the call is refused and nothing changes. The lead may give at most three extra rounds ("continue") within one count; after that the people decide at every limit. The reason is required (one or two sentences, no secrets): it is shown to the people and told to the implementer. Only the member the message named may decide, and only while the card is held.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "properties": {
            "current_state": {
              "type": "string",
            },
            "recommendation": {
              "properties": {
                "option_id": {
                  "type": "string",
                },
                "reason": {
                  "type": "string",
                },
              },
              "required": [
                "option_id",
                "reason",
              ],
              "type": "object",
            },
            "recurrence": {
              "type": "string",
            },
          },
          "required": [
            "recurrence",
            "current_state",
            "recommendation",
          ],
          "type": "object",
        },
        "decision": {
          "enum": [
            "continue",
            "replan",
            "to_owner",
          ],
          "type": "string",
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "task_key": {
          "description": "Task key, e.g. "AR-21".",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
      },
      "required": [
        "task_key",
        "decision",
        "reason",
      ],
      "type": "object",
    },
    "name": "decide_fix_limit",
    "title": "Decide how a card at its fix round limit goes on",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Decide a delegated permission request",
    },
    "description": "Answer a member's permission request that a team message handed to you as its decider: the tool call its CLI asks about, with its exact input. Read it completely first. allow only a routine step that plainly belongs to the task; deny what plainly does not; escalate everything else, which hands it to a person. Always escalate spending, new accounts, tokens or secrets, a lasting widening of what the host reaches, the live system, a release, publishing or main, a request that is cut off or unclear, and your own requests. The reason is required, short and without secrets: it is shown to the owner and the member. Only the decider of that request may answer, before its deadline; late answers are refused and never mean permission.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "deny",
            "escalate",
          ],
          "type": "string",
        },
        "reason": {
          "maxLength": 400,
          "minLength": 1,
          "type": "string",
        },
        "request_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$",
          "type": "string",
        },
      },
      "required": [
        "request_id",
        "decision",
        "reason",
      ],
      "type": "object",
    },
    "name": "decide_permission_request",
    "title": "Decide a delegated permission request",
  },
  {
