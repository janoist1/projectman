# The managed VM profile (PM-137): one root-managed source for bootstrap.sh and verify.sh.
# Plain KEY=value lines, read by `.` in a root shell: no spaces around `=`, no command text.
# bootstrap.sh copies this file to /etc/projectman/profile.env (root:root 0644); verify.sh
# reads the installed copy, so a change here reaches a machine only through bootstrap.sh.
# Keep PROFILE_VERSION in step with VM_PROFILE_VERSION in packages/shared/src/deploy/vm-readiness.ts.

PROFILE_NAME=managed-vm
# 2: the protected launcher and the egress gate of PM-140 are required checks.
PROFILE_VERSION=2

# --- Supported versions (pinned; verify.sh compares what is installed) ---------------------
# The guest is Ubuntu Server LTS, same release on a Mac VM (arm64) and a Linux server (amd64).
OS_ID=ubuntu
OS_VERSION_ID=24.04
# Node: an exact release, so two builds are the same. 22.23.3 was the newest 22.x listed on the
# npm registry when this was pinned; change it with a reason and re-run bootstrap.sh. Empty means
# "the newest of the major at install time" (not reproducible). The installer verifies the
# tarball against nodejs.org's SHASUMS256.txt and stops if that release does not exist.
NODE_MAJOR=22
NODE_MIN=22.12.0
NODE_VERSION=22.23.3
# The CLI versions the team has used (PM-126 probe, PM-137 baseline). They are installed from
# npm into a root-owned prefix that no worker or the service can write, with auto-update off,
# so a version changes only when this file changes. They are not strict-sandbox certifications.
CLAUDE_CLI_VERSION=2.1.284
CODEX_CLI_VERSION=0.159.1
CLI_PREFIX=/opt/projectman/cli

# --- Accounts and paths --------------------------------------------------------------------
SERVICE_USER=projectman
# Fixed, so the egress rules can name it. Outside the worker range and below 20000.
SERVICE_UID=19000
SERVICE_HOME=/var/lib/projectman
PROJECTMAN_HOME=/var/lib/projectman/data
APP_DIR=/srv/projectman
CONFIG_DIR=/etc/projectman
STATE_DIR=/var/lib/projectman-boundary
# One unprivileged account per team member: pmw-<handle>. Homes are not under the service home.
WORKER_PREFIX=pmw-
WORKER_HOME_ROOT=/var/lib/projectman-work
# Worker uids come from this reserved range; the egress rules match the whole range, so a
# worker added later is covered without editing the rules. Keep it in step with the .nft file.
WORKER_UID_MIN=20000
WORKER_UID_MAX=20999
# Group that may see all processes (procfs hidepid); systemd-logind joins it, nobody else.
PROC_GROUP=pmproc

# --- Access -------------------------------------------------------------------------------
APP_PORT=4700
SSH_PORT=22
# TCP ports besides APP_PORT that may listen on a non-loopback address.
ALLOWED_PUBLIC_TCP=22
# Unix socket path patterns a worker may use (system services every Linux has). Anything else
# a worker can write to is a control channel and fails worker-sockets.
WORKER_ALLOWED_SOCKETS="/run/dbus/* /run/systemd/* /dev/log /run/nscd/*"
# Filesystem types that mean the host shares a directory into the guest.
FORBIDDEN_FS_TYPES="9p virtiofs vboxsf fuse.sshfs fuse.vmhgfs-fuse vmhgfs prl_fs nfs nfs4 cifs smb3"
# Files that are a provider or GitHub login; none may exist in a worker home.
CREDENTIAL_FILES=".claude/.credentials.json .claude.json .codex/auth.json .config/gh/hosts.yml .git-credentials .ssh/id_rsa .ssh/id_ed25519"

# --- Probes (verify.sh) ---------------------------------------------------------------------
# TCP ports a worker is tried on at the gateway, the metadata address and the guest's own
# private address. 4800 is the owner's live app port on a Mac; 5173 the development server.
PROBE_TCP_PORTS="22 80 443 4700 4800 5173"
METADATA_ADDRESS=169.254.169.254
# A global IPv6 address (a public DNS server) tried on 443 when root can reach it itself.
PROBE_IPV6_PUBLIC=2001:4860:4860::8888
# One public host:port (a base destination) a worker must still reach through the egress proxy
# (positive control for the gate).
EGRESS_OPEN_PROBE=registry.npmjs.org:443
# Optional: addresses of other LAN or tailnet machines to try, space separated.
EXTRA_PROBE_ADDRESSES=
# The boundary probe (PM-140): a name the workers must not resolve or reach directly, a public DNS
# server they must not ask, and a destination outside the base list the proxy must refuse.
PROBE_PUBLIC_NAME=registry.npmjs.org
PROBE_DNS_SERVER=1.1.1.1
PROBE_DENIED_DESTINATION=example.com:443

# --- The VM boundary (PM-140) --------------------------------------------------------------
# bootstrap.sh writes these into BOUNDARY_CONFIG (JSON, root:root 0644), which the service and the
# launcher read. No secret goes there.
BOUNDARY_CONFIG=/etc/projectman/boundary.json
# The launcher's socket: created by projectman-launcher.socket, root:$SERVICE_USER 0660.
LAUNCHER_SOCKET=/run/projectman-launcher.sock
LAUNCHER_MAX_SESSIONS=16
# Hand-over bundles: <root>/<handle>/in (service writes, worker reads), .../out (the reverse).
SPOOL_ROOT=/var/lib/projectman-spool
# The egress proxy (in the service, loopback only): the workers' only way out. Keep the port in
# step with projectman-gate.nft (a test does).
EGRESS_PORT=4780
# Under /run: the service's per-member sockets behind each worker unit's bridge (its own network
# namespace reaches the app and the proxy only through them).
BRIDGE_DIR=projectman-bridge
# How long an allowed destination stays open, and how long its request may wait (1-24).
EGRESS_GRANT_HOURS=8
# Destinations every worker may reach without asking, host:port, exact names (no wildcards): the
# subscription CLIs' API and login, npm, GitHub. A first list: measure the pinned CLI versions
# against it (docs/VM.md, "Measuring the destinations") and change it here when they need more.
EGRESS_BASE="api.anthropic.com:443 claude.ai:443 console.anthropic.com:443 platform.claude.com:443 chatgpt.com:443 auth.openai.com:443 api.openai.com:443 registry.npmjs.org:443 github.com:443 api.github.com:443 codeload.github.com:443 objects.githubusercontent.com:443 raw.githubusercontent.com:443"
# The server refuses sessions when the newest readiness report is older than this.
READINESS_MAX_AGE_SECONDS=7200
