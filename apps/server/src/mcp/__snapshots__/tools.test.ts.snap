                  "label": {
                    "description": "Short button text.",
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "label",
                ],
                "type": "object",
              },
            ],
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array",
        },
        "question": {
          "description": "The decision in one plain sentence, then only the context needed to choose.",
          "maxLength": 4000,
          "minLength": 1,
          "type": "string",
        },
        "reask_of": {
          "description": "Only when the Operator answered, forwarded or closed your earlier question and you still need a person's answer: its id. The new one goes to the people unscreened; needs reask_reason.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "reask_reason": {
          "description": "Why a person must see it after all. Needs reask_of.",
          "maxLength": 1000,
          "minLength": 1,
          "type": "string",
        },
        "recipient": {
          "description": "Suggested todo recipient (default owner); screening decides. The integrator gets it when the screening member has machine access and an integrator is connected.",
          "enum": [
            "owner",
            "integrator",
          ],
          "type": "string",
        },
        "recommendation_reason": {
          "description": "Why you recommend it, in one plain sentence. Needs recommended.",
          "maxLength": 400,
          "minLength": 1,
          "type": "string",
        },
        "recommended": {
          "description": "The label of the option you recommend, written exactly the same way. Always give it, with recommendation_reason.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
