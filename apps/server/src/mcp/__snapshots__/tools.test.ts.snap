  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Read a project document",
    },
    "description": "Only the Operator, not in guest conversations; needs no open owner request. Read the decision log (decisions) or the roadmap (roadmap) as it is on the head of the project's default branch, fresh from the remote. The answer names the commit it was read at: pass it as base_commit to write_project_docs. A long file is read in parts with from_line and line_count; total_lines says how long it is. exists false: the file is not in the repository yet (the first write creates it).",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "doc": {
          "enum": [
            "decisions",
            "roadmap",
          ],
          "type": "string",
        },
        "from_line": {
          "description": "First line to return, from 1 (default 1).",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
        "line_count": {
          "description": "How many lines to return, at most 2000 (default 2000).",
          "maximum": 2000,
          "minimum": 1,
          "type": "integer",
        },
      },
      "required": [
        "doc",
      ],
      "type": "object",
    },
    "name": "read_project_doc",
    "title": "Read a project document",
  },
