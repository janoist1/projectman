  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Move a merge to the front of the queue",
    },
    "description": "Only the card's merger, or the Operator during an open owner request. One merge runs at a time per repository, in the order the cards were requested; use this to decide that this card's queued merge goes next, e.g. a fix that the queued cards' tests depend on. Only a merge that waits in the queue can move (not one that is not started yet or already runs). The merge that runs now is not interrupted. The reason goes on the card's timeline: say who or what it unblocks. A merge already at the front is left as it is (moved: false).",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "description": "Why this card goes first; it is shown on the timeline.",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "task_key": {
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
      },
      "required": [
        "task_key",
        "reason",
      ],
      "type": "object",
    },
    "name": "prioritize_merge",
    "title": "Move a merge to the front of the queue",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Propose a release",
    },
    "description": "Propose releasing this instance's default branch (or the merge commit \`commit\`) to the owners. Only a member with the deployment duty may call it. It makes a release card and an approval request in the owners' inbox; nothing is deployed until an owner approves, and the release watcher deploys it. The release has the merged cards between the last release and the commit. Only one release is open at a time. With \`preview: true\` nothing is recorded: the result lists the commit and the cards, so you can write the summary. Without it your session ends after the call: the owner decides and the watcher continues, so do nothing more afterwards.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "description": "A merge commit of a merged card; default: the head of the default branch.",
          "pattern": "^[0-9a-f]{40}$",
          "type": "string",
        },
        "preview": {
          "description": "Only list the commit and the cards of the release; record nothing (default false).",
          "type": "boolean",
        },
        "summary": {
          "description": "English markdown: what the release changes, as short bullets with the card keys. It becomes the text of the GitHub release.",
          "maxLength": 4000,
          "minLength": 1,
          "type": "string",
        },
        "title": {
          "description": "The release card title, e.g. "Release 2026.10.11".",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "title",
        "summary",
      ],
      "type": "object",
    },
    "name": "propose_release",
    "title": "Propose a release",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Read an attachment",
