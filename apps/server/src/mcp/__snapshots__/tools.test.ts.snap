    "name": "merge_task",
    "title": "Merge a task",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Open a todo for the integrator",
    },
    "description": "Only the selected PM in its internal general conversation; needs no owner request. When a stalled, silent, outage or nobody signal needs someone to act, open a todo in the integrator's queue instead of asking the owners: what to do, where, and what is expected. The Operator takes the todos from its queue one at a time and wakes for each; use this tool, not a message to the Operator, for a step that needs its hands. Its answer (done, or handed to the owners with the reason) comes back to you as the asker. When the integrator is not available the owners get it and the result says so. A card projectman already follows (an open or handed-over obligation) is refused with obligation_tracked: projectman wakes the responsible and hands the step over itself. A decision only the owners make (cost, deletion, publishing, direction, approval) is not a todo: use ask_human.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "expected": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string",
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "task_key": {
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
        "what": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "where": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "question",
        "what",
        "where",
        "expected",
      ],
      "type": "object",
    },
    "name": "open_integrator_todo",
    "title": "Open a todo for the integrator",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Operate the project",
    },
    "description": "Only the Operator, during an open owner request. Propose a configuration, member, session, message or project pause operation. The server executes immediate changes, requests owner approval for restricted changes, and refuses forbidden changes. Before changing a built-in role, use get_role_configuration, preserve existing instructions and other bundle fields, and send only the affected role in config_patch.roleOverrides. Each supplied bundle replaces that role completely; omitted roles stay unchanged. Set a role to null to reset only that role to built-in defaults; an empty map changes no roles. session_stop and message_send require plan (why, impact, reversible). message_send is for non-owner humans, with the exact text the owner approves. Title describes the result in the project language (1–120 characters).",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "op": {
                  "const": "config_patch",
                  "type": "string",
                },
                "patch": {
                  "additionalProperties": false,
                  "properties": {
                    "boundary": {
                      "properties": {
                        "enabled": {
                          "default": false,
                          "type": "boolean",
                        },
                        "leadTimeoutSeconds": {
                          "default": 120,
                          "maximum": 600,
                          "minimum": 1,
                          "type": "integer",
                        },
                      },
                      "type": "object",
                    },
                    "cardMover": {
                      "oneOf": [
                        {
                          "properties": {
                            "kind": {
                              "const": "worker",
                              "type": "string",
                            },
                          },
                          "required": [
                            "kind",
                          ],
                          "type": "object",
                        },
                        {
                          "properties": {
                            "kind": {
                              "const": "project_manager",
                              "type": "string",
                            },
                          },
                          "required": [
                            "kind",
                          ],
                          "type": "object",
                        },
                        {
                          "properties": {
                            "handle": {
                              "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                              "type": "string",
                            },
                            "kind": {
                              "const": "human",
                              "type": "string",
                            },
                          },
                          "required": [
                            "kind",
                            "handle",
                          ],
                          "type": "object",
                        },
                      ],
                    },
