  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List merge checks",
    },
    "description": "Read the project's recorded merge checks (the full check of a merge or of a merge train), newest first: the run time of the check, the workers it ran with, its scope and each step with its time and result (a step taken from the cache is marked, not timed). The time is the check itself; the queue wait is shown apart. A check recorded without a step report (an older engine) shows its steps as unknown. Filter by card, outcome, kind or period; get_task shows the latest checks of one card.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "checks",
          "description": "checks (default): the check of a single merge and of a train. diagnose is the per-card diagnosis of a failed train, which runs only the failed files.",
          "enum": [
            "checks",
            "merge",
            "train",
            "diagnose",
            "any",
          ],
          "type": "string",
        },
        "limit": {
          "default": 30,
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "outcome": {
          "default": "any",
          "description": "not_passed: failed, errored, cancelled or still running.",
          "enum": [
            "passed",
            "not_passed",
            "any",
          ],
          "type": "string",
        },
        "since": {
          "description": "Only checks requested at or after this time (ISO 8601 with a time zone).",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string",
        },
        "task_key": {
          "description": "Only the checks that included this card.",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
        "until": {
          "description": "Only checks requested before this time (ISO 8601 with a time zone).",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "list_merge_checks",
    "title": "List merge checks",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List tasks",
    },
    "description": "Read the project board as a compact list, newest update first. Defaults to open tasks (active, waiting or blocked). Filter by status, stage or assignee; use get_task for details. A theme (a card that groups other cards) is marked kind "theme"; it is in no stage, so a stage filter leaves themes out. A card in the project focus (what the team works on now) carries its place as "focus" (position, and via: the theme or card that covers it).",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "assignee": {
          "description": "Member handle, or "me" for your own tasks.",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "type": "string",
        },
        "limit": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
        "stage": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string",
        },
        "status": {
          "anyOf": [
            {
              "const": "open",
              "type": "string",
            },
            {
              "enum": [
                "active",
                "waiting",
                "blocked",
                "done",
                "cancelled",
              ],
              "type": "string",
            },
          ],
          "default": "open",
        },
      },
      "type": "object",
    },
    "name": "list_tasks",
    "title": "List tasks",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Mark the offered decision candidates",
    },
    "description": "Only the Operator, in the owner's own conversation, during an open owner request. Record what the owner said about the candidates you offered: recorded (they said yes and the entry is in the decision log; decision is its number, 1–10 characters), declined (they said no: never offer it again) or skipped (not a decision). All or nothing: one unknown item_id refuses the whole call with not_found. An item already marked can be marked again when the owner asks.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "decision": {
                "description": "The decision log entry number; only with recorded.",
                "maxLength": 10,
                "minLength": 1,
                "type": "string",
              },
              "item_id": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string",
              },
              "verdict": {
                "enum": [
                  "recorded",
                  "declined",
                  "skipped",
                ],
                "type": "string",
              },
            },
            "required": [
              "item_id",
              "verdict",
            ],
            "type": "object",
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "items",
      ],
      "type": "object",
    },
    "name": "mark_decision_candidates",
    "title": "Mark the offered decision candidates",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Merge a task",
    },
    "description": "Start merging the card's approved commit into its repository's default branch. Only the card's merger may call this. The result arrives as a team message. Call again to retry a failed or blocked merge.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "fix_conflict": {
          "description": "After a conflict failure, request a writable merge-fix worktree. Your session restarts when this turn ends.",
          "type": "boolean",
        },
        "resolution": {
          "description": "While fixing: describe what and where you resolved, after committing the mechanical conflict resolution.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "task_key": {
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
      },
      "required": [
        "task_key",
      ],
      "type": "object",
