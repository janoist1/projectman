                            "required": [
                              "id",
                              "name",
                              "origin",
                            ],
                            "type": "object",
                          },
                          "maxItems": 20,
                          "type": "array",
                        },
                      },
                      "type": "object",
                    },
                    "limits": {
                      "additionalProperties": false,
                      "properties": {
                        "aiEnabled": {
                          "type": "boolean",
                        },
                        "autoCompactWindowTokens": {
                          "anyOf": [
                            {
                              "maximum": 1000000,
                              "minimum": 100000,
                              "type": "integer",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "loopWatch": {
                          "properties": {
                            "count": {
                              "maximum": 50,
                              "minimum": 3,
                              "type": "integer",
