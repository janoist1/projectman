                },
                "principle": {
                  "additionalProperties": false,
                  "properties": {
                    "effect": {
                      "maxLength": 1000,
                      "minLength": 1,
                      "type": "string",
                    },
                    "example": {
                      "maxLength": 1000,
                      "minLength": 1,
                      "type": "string",
                    },
                    "id": {
                      "anyOf": [
                        {
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "principle": {
                      "maxLength": 1000,
                      "minLength": 1,
                      "type": "string",
