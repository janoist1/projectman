{
  "name": "get_role_configuration",
  "title": "Read one built-in role configuration",
  "description": "Read one built-in role's configuration version, stored override (null when absent) and effective full bundle, in your own general conversation (no owner request needed). Read it before editing a role; preserve its existing instructions and other bundle fields.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "role": {
        "type": "string",
        "enum": [
          "operator",
          "product_owner",
          "project_manager",
          "business_analyst",
          "architect",
          "designer",
          "developer",
          "lead_developer",
          "code_review",
          "security_review",
          "qa",
          "devops",
          "communication",
          "support",
          "researcher",
          "maintainer",
          "coach",
          "watchdog",
          "content",
          "translator",
          "docs",
          "accountant"
        ]
      }
    },
    "required": [
      "role"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Read one built-in role configuration",
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  }
}
