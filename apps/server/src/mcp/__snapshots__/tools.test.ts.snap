                          "required": [
                            "kind",
                          ],
                          "type": "object",
                        },
                        {
                          "properties": {
                            "handle": {
                              "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                              "type": "string",
                            },
                            "kind": {
                              "const": "human",
                              "type": "string",
                            },
                          },
                          "required": [
