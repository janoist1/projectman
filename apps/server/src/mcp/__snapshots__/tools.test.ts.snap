          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "event_id": {
          "description": "Id of a timeline event: returns its whole text. Only when a timeline line is cut.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "task_key": {
          "description": "Task key.",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
        },
      },
      "required": [
        "task_key",
      ],
      "type": "object",
    },
