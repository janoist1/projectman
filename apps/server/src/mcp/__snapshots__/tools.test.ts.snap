    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "attachment_id": {
          "description": "Message attachment id, e.g. "msa_…" (from the Attachments block of the message).",
