                      "items": {
                        "maxLength": 300,
                        "minLength": 1,
                        "type": "string",
                      },
                      "maxItems": 20,
                      "type": "array",
                    },
                    "involvement": {
                      "enum": [
                        "every_step",
                        "important",
                        "minimal",
                      ],
                      "type": "string",
                    },
                    "summary": {
                      "maxLength": 4000,
                      "minLength": 1,
                      "type": "string",
