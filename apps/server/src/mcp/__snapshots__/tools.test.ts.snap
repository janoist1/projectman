          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "task_key": {
          "description": "Task key, e.g. "AR-21".",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-\\d+$",
          "type": "string",
