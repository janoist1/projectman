  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List attachments",
    },
    "description": "List a task's attachments (files people and AI members attached), oldest first: id, file name, type, size, who attached it and when. get_task shows the first ones; use this for the rest.",
