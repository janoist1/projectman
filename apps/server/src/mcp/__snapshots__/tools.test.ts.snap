      "title": "Forward a feedback mark to the owner",
    },
    "description": "Pass a feedback mark you cannot or should not decide on to the owners (a decision of theirs, a matter beyond the project, something unclear): they get an alert with your reason, and the mark waits for them. After this you do not act on the mark again; the owner or a person who processes feedback settles it. The reason is for the owners only; the reply goes to the marker.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "mark_id": {
          "description": "The mark, e.g. "fbm_…".",
          "pattern": "^fbm_[a-z0-9]{10,32}$",
          "type": "string",
        },
        "reason": {
          "description": "Why the owner must decide, in a few sentences.",
          "maxLength": 1000,
          "minLength": 1,
          "type": "string",
        },
        "reply": {
          "description": "Your answer to the marker: what happens to the mark now.",
          "maxLength": 4000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "mark_id",
        "reason",
        "reply",
      ],
      "type": "object",
    },
    "name": "forward_feedback",
    "title": "Forward a feedback mark to the owner",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Read the project startup checklist",
    },
    "description": "Only the Operator or the project manager in their internal general session, never a guest. Needs no owner request. Returns the startup checklist (items with state, reason, condition and whether the condition holds now; progress; the base template) and, for each template, the item ids it would add. When there is no list yet, the answer says so; create it with update_checklist op init.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
