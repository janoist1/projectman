{
  "name": "projectman",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "projectman": "scripts/projectman/bin.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "projectman": "node scripts/projectman/bin.mjs",
    "demo": "node scripts/demo.mjs",
    "shots": "node --import tsx scripts/heavy/cli.ts node scripts/shots.mjs",
    "heavy": "node --import tsx scripts/heavy/cli.ts",
    "merge-test": "node --import tsx scripts/merge-test/cli.ts",
    "dead-code": "node --import tsx scripts/merge-test/dead-code-cli.ts",
    "knip": "knip --config knip.json --no-progress --no-config-hints --reporter json --no-exit-code",
    "dead-code:update": "node --import tsx scripts/merge-test/dead-code-cli.ts --update-baseline",
    "full-test": "node --import tsx scripts/full-test/cli.ts",
    "browsers": "node scripts/browsers.mjs",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @projectman/server",
    "dev:web": "npm run dev -w @projectman/web",
    "build": "npm run build -w @projectman/web && npm run build -w @projectman/feedback-widget && npm run build -w @projectman/server",
    "prepare:history-model": "npm run prepare:history-model -w @projectman/server --",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "control": "node --import tsx scripts/control/cli.ts",
    "migrate": "node --import tsx scripts/migrate/cli.ts",
    "engine": "node --import tsx scripts/engine/cli.ts",
    "administration": "node --import tsx scripts/administration/cli.ts",
    "live": "node --import tsx scripts/live/cli.ts",
    "cloud": "node --import tsx scripts/cloud/cli.ts",
    "release": "node --import tsx scripts/release/cli.ts",
    "release-test": "node --import tsx scripts/live/cli.ts release-test",
    "start": "npm run start -w @projectman/server",
    "typecheck": "node --import tsx scripts/heavy/cli.ts npm run typecheck --workspaces --if-present",
    "test": "node --import tsx scripts/heavy/cli.ts npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "knip": "6.42.1",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
